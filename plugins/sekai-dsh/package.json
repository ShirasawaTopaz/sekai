{
  "name": "@sekai/dsh-plugin",
  "version": "0.2.0",
  "description": "Sekai bridge plugins for dsh (DeepSeek Harness): drives `sekai-router --serve` (JSONL over stdio) and the `sekai-worker connect` lifecycle (with the autoConnect switch that resumes the last connected router, manual connect/disconnect tools, prompt relaying and opt-in virtual GPIO), publishing sekai_* tools.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShirasawaTopaz/sekai.git",
    "directory": "plugins/sekai-dsh"
  },
  "type": "module",
  "main": "./lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./router": "./lib/router.js",
    "./worker": "./lib/worker.js",
    "./router/locale/*.json": "./locale/router/*.json",
    "./worker/locale/*.json": "./locale/worker/*.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./router/icon": "./icons/router.svg",
    "./worker/icon": "./icons/worker.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icons",
    "docs",
    "scripts",
    "README.md",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/shared.js && node --check lib/router.js && node --check lib/worker.js && node --check lib/status.js && node --check lib/client.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "sekai",
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "iot"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dependencies": {},
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-api-gateway"]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
